{
  "name": "@cachai/promptier-core-editor",
  "version": "0.1.0",
  "description": "Framework-agnostic editor for LLM prompts, exposed as a Custom Element.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuanPaLA/promptier.git",
    "directory": "core-editor"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./format": "./src/prompt/serialization/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/editor.cjs",
    "module": "./dist/editor.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/editor.js",
        "require": "./dist/editor.cjs"
      },
      "./format": {
        "types": "./dist/types/prompt/serialization/index.d.ts",
        "import": "./dist/format.js",
        "require": "./dist/format.cjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest"
  },
  "dependencies": {
    "prosemirror-commands": "^1.6.0",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.4.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.22.3",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.34.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
