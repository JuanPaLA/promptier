{
  "name": "core-editor",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./format": "./src/prompt/serialization/index.ts",
    "./standalone": "./src/standalone.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/editor.js",
        "require": "./dist/editor.cjs"
      },
      "./format": {
        "types": "./dist/types/prompt/serialization/index.d.ts",
        "import": "./dist/format.js",
        "require": "./dist/format.cjs"
      },
      "./standalone": "./dist/promptier.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build -c vite.standalone.config.ts && tsc -p tsconfig.build.json",
    "test": "vitest"
  },
  "dependencies": {
    "prosemirror-commands": "^1.6.0",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.4.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.22.3",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.34.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
