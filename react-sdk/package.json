{
  "name": "@cachai/promptier-react-sdk",
  "version": "0.1.0",
  "description": "React component for editing LLM prompts, built on @cachai/promptier-core-editor.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuanPaLA/promptier.git",
    "directory": "react-sdk"
  },
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@cachai/promptier-core-editor": "workspace:^",
    "@nbottarini/react-presenter": "^1.0.0-rc"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
